# Copy this file to .env.local and fill in real values. Never commit secrets.

# Canonical site URL, used for metadata, sitemap and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://www.lionswitch.com

# --- Email (contact form, newsletter notifications, holiday preferences) ---
# Any standard SMTP provider works (e.g. Google Workspace, SendGrid, Postmark).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Lion Switch Website <info@lionswitch.com>"

# --- Newsletter signup (footer) ---
# Google Apps Script webhook URL that appends a row to a Google Sheet.
NEWSLETTER_SHEET_WEBHOOK_URL=

# --- Holiday preferences form ---
# Separate Google Apps Script webhook URL/sheet for holiday submissions.
# Holiday form -> Lion Switch dashboard "Holiday requests" inbox (/admin).
# URL: https://<your-dashboard-host>/api/intake/holiday-preferences
# Secret: the same random value set as HOLIDAY_INTAKE_SECRET on the dashboard service.
HOLIDAY_DASHBOARD_URL=
HOLIDAY_INTAKE_SECRET=

# --- Analytics ---
# Only loaded after the visitor accepts the cookie banner.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

